# Dockerfile für PHP (docker-compose)
FROM php:8.4-fpm-alpine

# ARGS/ENV
ENV MAGICK_HOME=/usr
ENV PHP_CS_FIXER_IGNORE_ENV=1
ENV PATH="$PATH:/app/vendor/bin"

# Custom Ini
COPY etc/php.ini /usr/local/etc/php/conf.d/custom.ini

#Deps
RUN apk add --no-cache \
    git \
    icu-libs \
    imagemagick \
    libpng \
    libjpeg-turbo \
    libzip \
    libxml2 \
    libcurl \
    openssl

# Yoink Composer from the Composer Image
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

RUN chmod +x /usr/bin/composer \
    && apk add --no-cache --virtual .build-deps \
       g++ make autoconf linux-headers icu-dev imagemagick-dev libpng-dev jpeg-dev libzip-dev libxml2-dev \
    && docker-php-ext-configure zip \
    && docker-php-ext-configure gd --with-jpeg \
    && docker-php-ext-install zip intl gd pdo pdo_mysql bcmath gd soap fileinfo intl\
    && pecl download imagick \
    && tar -xzf imagick-*.tgz \
    && cd imagick-* \
    && phpize \
    && ./configure CPPFLAGS='-Dphp_strtolower=zend_str_tolower' \
    && make -j$(nproc) \
    && make install \
    && cd .. \
    && rm -rf imagick-* \
    && docker-php-ext-enable imagick \
    && pecl install xdebug \
    && docker-php-ext-enable xdebug \
    && apk del .build-deps

# project files
WORKDIR /app

# Composer Base, for Tooling
COPY composer.json composer.lock* /app/
RUN composer install --no-interaction --optimize-autoloader
COPY . /app